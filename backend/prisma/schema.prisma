generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int            @id @default(autoincrement())
  fullName         String
  email            String         @unique
  password         String
  phone            String?
  age              Int
  gender           Gender
  profession       String?
  city             String?        @db.VarChar(100)
  bio              String?
  profileImage     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  isActive         Boolean        @default(true)
  role             Role           @default(USER)
  receivedRequests MatchRequest[] @relation("Receiver")
  sentRequests     MatchRequest[] @relation("Sender")
  trips            Trip[]
}

model Trip {
  id          Int            @id @default(autoincrement())
  userId      Int
  destination String         @db.VarChar(100)
  startDate   DateTime
  endDate     DateTime
  budget      Int?
  tripType    TripType
  description String?
  status      TripStatus     @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  requests    MatchRequest[]
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MatchRequest {
  id         Int         @id @default(autoincrement())
  senderId   Int
  receiverId Int
  tripId     Int
  status     MatchStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  receiver   User        @relation("Receiver", fields: [receiverId], references: [id])
  sender     User        @relation("Sender", fields: [senderId], references: [id])
  trip       Trip        @relation(fields: [tripId], references: [id])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TripStatus {
  OPEN
  FULL
  COMPLETED
  CANCELLED
}

enum TripType {
  TREKKING
  ROADTRIP
  BACKPACKING
  BEACH
  CAMPING
}

enum Role {
  USER
  ADMIN
}